# ==========================================
# CAMEO Project .gitignore
# Clean, professional, and secure
# ==========================================

# --- Environment & Secrets ---
# Crucial: Never commit API keys, passwords, or configuration secrets!
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*
!.env.example

# --- Frontend (Node / Vite / React / TypeScript) ---
node_modules/
/dist
/dist-ssr
/build
/out
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.eslintcache
.parcel-cache
.vite
.next
.nuxt
.tsbuildinfo

# --- Backend (Python) ---
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/
.tox/
.noseids
nosetests.xml
.hypothesis/
.ipynb_checkpoints
*.egg-info/
.python-version
pip-log.txt
pip-delete-this-directory.txt
.venv/
venv/
env/
ENV/
pyvenv.cfg
.mypy_cache/
.pyre/

# --- Database & Storage (Generated at runtime) ---
# All SQLite databases and their WAL/SHM sidecar files
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
# Explicit paths for belt-and-suspenders coverage
backend/data/*.db
backend/data/*.db-wal
backend/data/*.db-shm
backend/data/*.db-journal
backend/data/temp_*.db
backend/data/.flask_secret_key

# --- Project Uploads & Temp Files ---
# Ignore uploaded files, but keep the directory (using .gitkeep)
backend/uploads/*
!backend/uploads/.gitkeep

# Temporary files and backups
*.tmp
*.bak
*.temp
.cache/
sass-cache/

# --- Graphify Code Graph & Agent Memory ---
graphify-out/
.agents/
agent_memory/

# NOTE: backend/data/ (runtime DBs) is covered above.
# The top-level data/map/ folder contains architecture docs and IS tracked.

# --- Custom Untracked Assets ---
PDF_Folder/
resources/
tests/

# --- Local Documentation & Reports ---
# Keep Markdown notes/reports out of GitHub commits.
*.md
*.MD

# --- Editor / IDE & OS Files ---
# IDE specific files
.vscode/
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~

# Operating system files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
